{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Adam",
  "version": "0.1.0",
  "identifier": "com.saeedhub.adam",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Adam",
        "width": 360,
        "height": 520,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": false,
        "shadow": false,
        "visible": true,
        "center": true,
        "backgroundColor": "#00000000",
        "backgroundThrottling": "disabled"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "SaeedHub",
    "homepage": "https://github.com/saeedhub101/Adam",
    "shortDescription": "Adam Windows AI desktop companion",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": [
          "English"
        ],
        "installerHooks": "./windows/hooks.nsh"
      },
      "wix": {
        "upgradeCode": "6c4c8e4f-3b5d-4c72-9a9a-0b4c5c5c8d2e",
        "fragmentPaths": [
          "./windows/fragments/cleanup.wxs"
        ],
        "componentRefs": [
          "AdamCleanupRoamingData",
          "AdamCleanupLocalData",
          "AdamCleanupLegacyLocalData"
        ]
      }
    },
    "icon": [
      "icons/icon.ico"
    ]
  }
}
